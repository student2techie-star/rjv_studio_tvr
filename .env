# Frontend-safe variables only.
# NEVER place WhatsApp Business / Cloud API tokens (e.g. WHATSAPP_ACCESS_TOKEN) in Vite client code.

# Studio WhatsApp number in international format (country code + number, no +).
VITE_WHATSAPP_NUMBER=919003430930

# Optional secure backend for the Frames upload (leave empty until connected).
# e.g. https://api.example.com
VITE_API_BASE_URL=

# Google Maps embed URL for the Contact page (leave empty to show the placeholder).
VITE_GOOGLE_MAPS_EMBED_URL=

# Live site URL used for canonicals / Open Graph (update after deployment).
VITE_SITE_URL=https://rjvstudios.github.io/rjv_studio_tvr/